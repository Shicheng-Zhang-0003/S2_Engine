#!/usr/bin/env bash
#
# run — build the engine, run it, and refuse to destroy the record silently.
#
# AUDIT FIX M6: this used to be one line,
#     ./carbonsim > output.txt
# which overwrote the committed record with whatever the current tree
# happened to produce and told you nothing. Because output.txt and
# CURRENT_BASELINE_SHA.txt are both tracked and together are the project's
# provenance claim, a single stray ./run destroyed the ability to tell an
# intended record update from an accidental one: `git diff` afterwards showed
# only a changed output.txt, with no marker of whether the new values were
# wanted. Every later verification script then reported "record not intact",
# which reads as an engine defect and is really just the overwrite.
#
# The record is now regenerated deliberately and never in place:
#   1. output goes to a timestamped file under the caller, never to output.txt;
#   2. the previous digest is reported before and after, side by side;
#   3. promoting the new run to output.txt + CURRENT_BASELINE_SHA.txt is an
#      explicit second step, so the diff a reviewer sees is the record change
#      itself and nothing else.
#
# Usage:
#   ./run                 run, write runs/<stamp>.txt, print digests
#   ./run --accept        ...and also promote the result to the record
#   ./run --help
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"

RECORD=output.txt
LEDGER=CURRENT_BASELINE_SHA.txt
RUNS_DIR=runs

usage() { sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; }

sha() { [ -f "$1" ] && sha256sum "$1" | cut -d' ' -f1 || echo "(absent)"; }

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then usage; exit 0; fi

case "${1:-}" in
  "")         ACCEPT=0 ;;
  --accept)   ACCEPT=1 ;;
  *)          echo "run: unknown argument '$1' (try --help)" >&2; exit 2 ;;
esac

command -v sha256sum >/dev/null || { echo "run: sha256sum not found" >&2; exit 2; }

printf 'run: building\n' >&2
# Full-audit P20: clean-first + warning gate. An incremental `make` is a no-op
# against tracked objects and cannot fail (B1 class). Fail closed on warnings.
make clean >/dev/null 2>&1
# FULL-AUDIT O23: hermetic log path (missing dir previously failed closed-open).
# FULL-AUDIT Q4: the default was /tmp/opencode, which is a scratch directory
# belonging to one tool rather than a general temporary location: on any
# machine that has not set TMPDIR this silently created a stray "opencode"
# tree under /tmp and wrote the build log inside it. The default is now the
# conventional /tmp, still overridable with TMPDIR, and the directory is
# created explicitly so a missing TMPDIR can never fail the run open.
AUDIT_TMP="${TMPDIR:-/tmp}/s2audit"
mkdir -p "$AUDIT_TMP" || { echo "run: cannot create scratch dir $AUDIT_TMP" >&2; exit 1; }
if ! make > "$AUDIT_TMP/run_build.log" 2>&1; then echo "run: clean build failed" >&2; exit 1; fi
if grep -q 'warning:' "$AUDIT_TMP/run_build.log"; then echo "run: build produced warnings" >&2; exit 1; fi

STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "$RUNS_DIR"
OUT="$RUNS_DIR/$STAMP.txt"
ERR="$RUNS_DIR/$STAMP.stderr.txt"
CVMD="$RUNS_DIR/$STAMP.cvmds"

# FULL-AUDIT O17: byte-stable side artifacts. ds_open() honors
# SOURCE_DATE_EPOCH; default to the tree's own commit time so repeated
# runs seal identically unless the caller overrides.
if [ -z "${SOURCE_DATE_EPOCH:-}" ]; then
  SOURCE_DATE_EPOCH="$(git log -1 --format=%ct 2>/dev/null || date +%s)"
  export SOURCE_DATE_EPOCH
fi

printf 'run: executing (about two minutes)\n' >&2
./carbonsim > "$OUT" 2> "$ERR"
# FULL-AUDIT O21: stage the kcsa.cvmds side effect alongside stdout so the
# sealed pair cannot fork (record = stdout + cvmds, promoted atomically).
if [ -f kcsa.cvmds ]; then cp kcsa.cvmds "$CVMD"; fi

if [ -s "$ERR" ]; then
  echo "run: engine wrote to stderr; not promoting a run whose stderr is not empty" >&2
  sed -n '1,20p' "$ERR" >&2
fi

NEW="$(sha "$OUT")"
OLD="$(sha "$RECORD")"
# FULL-AUDIT: the ledger and the record were compared side by side and
# never compared WITH EACH OTHER, so a tree whose output.txt and
# CURRENT_BASELINE_SHA.txt disagreed (exactly the state a stale record
# produces) was reported as "recorded record: X / recorded ledger: Y"
# with no complaint. The two must agree.
LEDGER_SHA="$(cat "$LEDGER" 2>/dev/null | tr -d ' \n' || echo '(absent)')"
if [ "$LEDGER_SHA" != "(absent)" ] && [ "$LEDGER_SHA" != "$OLD" ]; then
  echo "run: REFUSING to run: $LEDGER does not match $RECORD" >&2
  echo "      ledger : $LEDGER_SHA" >&2
  echo "      record : $OLD" >&2
  echo "      the record and its ledger are out of step; promote one of" >&2
  echo "      them deliberately before recording anything new." >&2
  exit 1
fi

echo
echo "  recorded record : $OLD"
echo "  this run         : $NEW   ($OUT)"
echo "  recorded ledger  : $(cat "$LEDGER" 2>/dev/null | tr -d ' \n' || echo '(absent)')"

if [ -z "$(cat "$ERR")" ] && [ "$OLD" = "$NEW" ]; then
  echo "  verdict          : identical to the record; nothing to promote (stdout)"
  # FULL-AUDIT: a plain ./run used to REFRESH the tracked kcsa.cvmds even
  # though stdout stood still, so an unadmitted run left the tracked
  # artifact modified (git status showed " M kcsa.cvmds"). The sidecar is
  # now promoted only by --accept, like the record itself.
  if [ -f "$CVMD" ] && [ -x ./build/verify_cvmds ] && ./build/verify_cvmds "$CVMD" >/dev/null 2>&1; then
    if ! cmp -s "$CVMD" kcsa.cvmds; then
      echo "  sidecar          : staged kcsa.cvmds differs from the tracked one;"
      echo "                    it is NOT refreshed by a plain run (use --accept)"
    fi
  fi
  exit 0
fi

# FULL-AUDIT O22: promotion requires empty stderr AND a green verifier.
# An empty stderr alone can still promote red science; warn loudly.
if [ "$ACCEPT" -eq 1 ] && [ -z "$(cat "$ERR")" ]; then
  # FULL-AUDIT: the staged sidecar is NOT promoted unless its seal
  # verifies. The old code printed a warning and then copied the file
  # anyway - so a TAMPERED or TRUNCATED kcsa.cvmds replaced the tracked,
  # sealed artefact while the log said "promoting stdout only". Worse,
  # when ./build/verify_cvmds was missing the `!` chain made the whole
  # condition false, so an unverified file was promoted SILENTLY.
  # The sidecar is part of the record (stdout + sealed datastream), so
  # an unverifiable sidecar is a hard refusal.
  if [ -f "$CVMD" ]; then
    if [ ! -x ./build/verify_cvmds ]; then
      echo "run: REFUSING promotion: build/verify_cvmds is missing, so the" >&2
      echo "      staged kcsa.cvmds seal cannot be checked" >&2
      exit 1
    fi
    if ! ./build/verify_cvmds "$CVMD" >/dev/null 2>&1; then
      echo "run: REFUSING promotion: the staged kcsa.cvmds seal did not" >&2
      echo "      verify. The record is stdout PLUS the sealed datastream;" >&2
      echo "      promoting an unverifiable sidecar would break that." >&2
      exit 1
    fi
  fi
  if ! make test >/dev/null 2>&1; then
    echo "run: REFUSING promotion: make test is red (run with empty arg to stage without promoting)" >&2
    exit 1
  fi
  # FULL-AUDIT: the promotion is ATOMIC. `cp` truncates the destination
  # before it writes, so an interruption mid-copy left a TRUNCATED
  # output.txt - the record destroyed, and the ledger disagreeing with
  # it. Each artefact is now written to a temporary name in the same
  # directory and renamed into place (rename is atomic within a
  # filesystem), and the ledger is written LAST so it never advertises
  # a digest the record does not have.
  cp "$OUT" "$RECORD.tmp"
  if [ -f "$CVMD" ]; then cp "$CVMD" kcsa.cvmds.tmp; fi
  mv -f "$RECORD.tmp" "$RECORD"
  if [ -f "$CVMD" ]; then mv -f kcsa.cvmds.tmp kcsa.cvmds; fi
  printf '%s\n' "$NEW" > "$LEDGER.tmp"
  mv -f "$LEDGER.tmp" "$LEDGER"
  echo "  verdict          : PROMOTED to $RECORD and $LEDGER (+ kcsa.cvmds)"
  echo "                    review 'git diff $RECORD' before committing"
  echo "                    then run ./verify_scripts.sh && ./s01_verify_record.sh"
  exit 0
fi

echo "  verdict          : differs from the record, left unpromoted"
echo "                    inspect 'git diff --no-index $RECORD $OUT', then"
echo "                    re-run as './run --accept' to promote it"
[ "$ACCEPT" -eq 1 ] && exit 1
exit 0